{
	"luci-app-airoha-npu": {
		"description": "Control Airoha hardware flow offloading through firewall UCI settings",
		"read": {
			"uci": [
				"firewall"
			],
			"file": {
				"/sys/bus/platform/drivers/airoha-npu": [
					"list"
				]
			},
			"ubus": {
				"luci.airoha_npu": [
					"getStatus",
					"getPpeEntries"
				]
			}
		},
		"write": {
			"uci": [
				"firewall"
			],
			"ubus": {
				"luci.airoha_npu": [
					"setGovernor",
					"setMaxFreq",
					"setOverclock"
				]
			}
		}
	}
}
